# Pick ONE AI provider. Leave GEMINI_API_KEY empty to use local Ollama.
GEMINI_API_KEY=

# Qdrant Cloud: paste values from https://cloud.qdrant.io (cluster URL + API key).
# Leave QDRANT_URL empty to store vectors in a local folder instead.
QDRANT_URL=
QDRANT_API_KEY=

# Ollama (only used when GEMINI_API_KEY is empty)
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=qwen2.5:3b
